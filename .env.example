# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Telnyx
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PUBLIC_KEY=your_telnyx_public_key

# Discord (VOICE_PROVIDER=discord)
DISCORD_BOT_TOKEN=your_discord_bot_token
# Public URL of this server so Deepgram can reach /v1/chat/completions.
# Run `ngrok http 8000` and paste the HTTPS URL here.
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# OpenClaw
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token

# Server
HOST=0.0.0.0
PORT=8000

# Provider Selection (twilio, telnyx, or discord)
VOICE_PROVIDER=twilio

# Voice agent model (optional — defaults to claude-haiku-4-5 for low latency)
# OPENCLAW_VOICE_MODEL=anthropic/claude-haiku-4-5-20251001
