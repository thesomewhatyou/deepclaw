# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Telnyx
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PUBLIC_KEY=your_telnyx_public_key

# OpenClaw
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token

# Server
HOST=0.0.0.0
PORT=8000

# Public HTTPS URL of this server so Deepgram can reach /v1/chat/completions.
# Expose port 8000 with any tunnel tool, then paste the URL here.
#
# Examples:
#   ngrok:              ngrok http 8000
#   Cloudflare Tunnel:  cloudflared tunnel --url http://localhost:8000
#   localtunnel:        lt --port 8000
#   Tailscale Funnel:   tailscale funnel 8000
#   (or deploy to a public server and use its URL directly)
#
PUBLIC_URL=https://your-tunnel-url.example.com

# Provider Selection (twilio or telnyx)
VOICE_PROVIDER=twilio

# Voice agent model (optional — defaults to claude-haiku-4-5 for low latency)
# OPENCLAW_VOICE_MODEL=anthropic/claude-haiku-4-5-20251001
